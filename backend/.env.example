# ─────────────────────────────────────────
#  CosmoAI — Variables d'environnement
#  Copiez ce fichier en .env et adaptez.
# ─────────────────────────────────────────

# ── Mode démo (sans Ollama) ───────────────
# true  → mock statique instantané, aucune dépendance Ollama
# false → appel Ollama réel
DEMO_MODE=true

# ── Sécurité JWT ─────────────────────────
# Générez avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGEZ_MOI_avec_une_vraie_clé_aléatoire

# ── Ollama (ignoré si DEMO_MODE=true) ────
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT=180

# ── CORS (origines autorisées) ────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Dossiers ─────────────────────────────
UPLOAD_FOLDER=uploads
EXPORT_FOLDER=exports

# ── Google Places (optionnel) ────────────
# GOOGLE_PLACES_API_KEY=AIza...
